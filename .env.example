# Copy this file to .env and provide your local secrets
# JWT_SECRET must be at least 32 characters. Generate e.g.: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000
DB_USERNAME=postgres
DB_PASSWORD=

# Initial admin bootstrap (prod). Leave blank to disable.
# Password must satisfy the policy: >=8 chars with a letter, digit and special char.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
